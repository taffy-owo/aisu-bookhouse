# Local development. Copy to backend/.env and set your own values before starting.
AISU_ENV=development
AISU_JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-characters
AISU_ENCRYPTION_KEY=replace-with-a-separate-random-secret-of-at-least-32-characters
AISU_DATABASE_URL=sqlite+pysqlite:///./aisu-bookhouse-dev.db
AISU_STORAGE_ROOT=./data
AISU_AUTO_CREATE_TABLES=true
AISU_BOOTSTRAP_ADMIN=true
AISU_SEED_DEMO_DATA=false
AISU_DEFAULT_ADMIN_EMAIL=admin@example.com
AISU_DEFAULT_ADMIN_PASSWORD=replace-with-your-own-admin-password
AISU_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AISU_UPLOAD_PROCESSING_MODE=background
AISU_JWT_EXPIRE_MINUTES=1440
AISU_JWT_REFRESH_EXPIRE_DAYS=30

# Optional AI features: configure a channel in the web settings, or set these.
# Do not put API keys in frontend VITE_* variables.
# AISU_AI_ALLOWED_BASE_HOSTS=api.example.com
# AISU_AI_TRANSLATION_BASE_URL=https://api.example.com/v1
# AISU_AI_TRANSLATION_API_KEY=your-server-side-api-key
# AISU_AI_TRANSLATION_MODEL=your-model-name
# AISU_AI_TRANSLATION_GLOBAL_DAILY_CALL_BUDGET=1000
# AISU_TRANSLATION_ENGINE=v2

# Optional OAuth: configure all values for the provider you enable.
# AISU_OAUTH_FRONTEND_REDIRECT_URI=https://books.example.com/login
# AISU_GOOGLE_OAUTH_CLIENT_ID=your-client-id
# AISU_GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret
# AISU_GOOGLE_OAUTH_REDIRECT_URI=https://books.example.com/api/v1/auth/oauth/google/callback
# AISU_DISCORD_OAUTH_CLIENT_ID=your-client-id
# AISU_DISCORD_OAUTH_CLIENT_SECRET=your-client-secret
# AISU_DISCORD_OAUTH_REDIRECT_URI=https://books.example.com/api/v1/auth/oauth/discord/callback

